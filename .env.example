# Copy this file to .env and fill in what you need. Every value may stay empty: an empty value means "not set", and the server
# uses its default. docs/HOSTING.md explains each one ("Run the server", "Guests and members", "Run in Docker").

# --- Public server in Docker (compose.yaml, with Caddy) ---
# The name Caddy serves, for example play.example.com. Required there: compose stops with a message while it is empty.
RG_DOMAIN=

# --- Discord sign-in, for a public server (all three are needed; otherwise it is name-only login) ---
RG_DISCORD_CLIENT_ID=
RG_DISCORD_CLIENT_SECRET=
# The address players use, with no path. In Docker it defaults to https://<RG_DOMAIN>, so leave it empty there.
RG_PUBLIC_URL=
# Optional: your community link (https://discord.gg/...), shown as "Join the Discord" in the footer.
RG_DISCORD_INVITE=
# Required on a public server, which won't start without all three: they fill in its Terms and Privacy policy (docs/adr/0021).
# Who runs the server, by legal name, and who stores its data for you, such as "Example Cloud, Jakarta". One line each.
RG_ADMIN_NAME=
RG_HOSTING=
# Where players and rights holders can write: an email address or an https address. The Terms, the Privacy policy and the Notices
# dialog link to it. A public page, such as a GitHub profile, means requests arrive in public (docs/LEGAL.md).
RG_CONTACT=

# --- The server copy of the game (optional) ---
# With `npm start`: the .zip or the extracted folder. The server runs it to decide battle results (its witness) and, unless it
# is --public, for bots. Without it, battle results are guessed, and every player chooses their own copy.
# A server that isn't --public sends it to every visitor. A --public server sends it only to visitors with its download code,
# which `npm run download-code` makes and ends (docs/adr/0031, docs/LEGAL.md); without a code it sends it to nobody.
RG_GAME=
# With Docker: the same, as a path on the host; start a relative path with ./
RG_GAME_PATH=
# What a --public server sends for its download code in a day, in MiB, before it sends no more until the next day (UTC) [700].
RG_GAME_MB_PER_DAY=

# --- Docker on a private network (compose.lan.yaml) ---
# Who can connect to the page and the Java client's port: 127.0.0.1 is this PC only, 0.0.0.0 is your network. Empty means this PC.
BIND=

# --- Behind a reverse proxy, and limits (defaults in brackets) ---
# 1 when exactly one proxy sits in front, so the guest limit uses the client's address. compose.yaml sets it to 1 itself [off].
RG_TRUST_PROXY=
# New guests one address (an IPv6 /64 network) can make per hour [30], and guest accounts the server holds at once [5000].
RG_GUESTS_PER_IP_HOUR=
RG_GUEST_CAP=

# --- Deleting an account (npm run delete-user) and the download code (npm run download-code) ---
# A long random secret, for example the output of: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Empty means the server has no admin endpoint at all. With Docker, run the commands inside the container: see "Delete an account"
# and "Send the game with a download code" in docs/HOSTING.md.
RG_ADMIN_TOKEN=

# --- Matches ---
# 1 for friendly matches with no countdown, as `--relaxed` does [off].
RG_RELAXED_FRIENDLY=
# 0 keeps no replays of online battles and serves none of those already kept (CONTEXT.md "Replay", docs/HOSTING.md "Replays") [on].
RG_REPLAYS=

# --- Visitor statistics (npm run stats) ---
# 1 counts the visitors of a --public server: page opens, unique visitors, referring sites, countries and kinds of device, each
# day on its own, kept 25 months; the Privacy policy then says so. Ignored on a server that isn't public (docs/HOSTING.md
# "Visitor statistics", docs/adr/0043) [off].
RG_STATS=
