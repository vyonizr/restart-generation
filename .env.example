# Copy this file to .env and fill in what you need. Every value may stay empty: an empty value means "not set", and the server
# uses its default. The README explains each one ("Run the server", "Guests and members", "Run in Docker").

# --- Public server in Docker (compose.yaml, with Caddy) ---
# The name Caddy serves, for example play.example.com. Required there: compose stops with a message while it is empty.
RG_DOMAIN=

# --- Discord sign-in, for a public server (all three are needed; otherwise it is name-only login) ---
RG_DISCORD_CLIENT_ID=
RG_DISCORD_CLIENT_SECRET=
# The address players use, with no path. In Docker it defaults to https://<RG_DOMAIN>, so leave it empty there.
RG_PUBLIC_URL=
# Optional: your community link (https://discord.gg/...), shown as "Join the Discord" in the footer.
RG_DISCORD_INVITE=
# Where a rights holder can ask for the game's removal: an email address or an https address. Required with RG_GAME_PATH on a public server,
# which won't start without it; the page shows it in the footer (docs/LEGAL.md).
RG_CONTACT=

# --- Your copy of the game (optional) ---
# With `npm start`: the .zip or the extracted folder. Setting it lets this server send the game to every visitor, and run bots
# unless it is --public. Without it each player chooses their own copy (ADR 0001).
RG_GAME=
# With Docker: the same, as a path on the host; start a relative path with ./
RG_GAME_PATH=

# --- Docker on a private network (compose.lan.yaml) ---
# Who can connect to the page and the Java client's port: 127.0.0.1 is this PC only, 0.0.0.0 is your network. Empty means this PC.
BIND=

# --- Behind a reverse proxy, and limits (defaults in brackets) ---
# 1 when exactly one proxy sits in front, so the guest limit uses the client's address. compose.yaml sets it to 1 itself [off].
RG_TRUST_PROXY=
# New guests one address can make per hour [10], and guest accounts the server holds at once [5000].
RG_GUESTS_PER_IP_HOUR=
RG_GUEST_CAP=

# --- Deleting an account (npm run delete-user) ---
# A long random secret, for example the output of: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Empty means the server has no delete endpoint at all. With Docker, run the command inside the container: see "Delete an account" in the README.
RG_ADMIN_TOKEN=

# --- Matches ---
# 1 for friendly matches with no countdown, as `--relaxed` does [off].
RG_RELAXED_FRIENDLY=
