  "scripts": {
    "build": "vite build",
    "dev:web": "node tools/ensure-web.mjs --vite && node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "start": "node tools/ensure-web.mjs && node --env-file-if-exists=.env server/gateway.js",
    "start:lan": "node tools/ensure-web.mjs && node --env-file-if-exists=.env server/gateway.js --lan",
    "start:relaxed": "node tools/ensure-web.mjs && node --env-file-if-exists=.env server/gateway.js --relaxed",
    "start:lan:relaxed": "node tools/ensure-web.mjs && node --env-file-if-exists=.env server/gateway.js --lan --relaxed",
    "dev": "node tools/ensure-web.mjs && node --env-file-if-exists=.env --watch server/gateway.js",
    "dev:lan": "node tools/ensure-web.mjs && node --env-file-if-exists=.env --watch server/gateway.js --lan",
    "test": "node server/snap.test.js && node server/store.test.js && node server/auth.test.js && node server/admin.test.js && node server/gateway.test.js && node server/gateway.auth.test.js && node server/bots.test.js && node server/aiprofiles.test.js && node server/casino.test.js && node tools/legal-check.test.mjs && node tools/legal-check.mjs",
    "selfplay": "node --env-file-if-exists=.env tools/selfplay.mjs",
    "test:battle": "node server/battle.test.js",
    "test:gameblob": "node --env-file-if-exists=.env server/gameblob.test.js",
    "browser-test": "node --env-file-if-exists=.env web/tools/browser-test.mjs",
    "boot": "node --env-file-if-exists=.env web/tools/boot.mjs",
    "delete-user": "node --env-file-if-exists=.env server/delete-user.mjs",
    "legal-check": "node tools/legal-check.mjs",
    "hooks": "node tools/legal-check.mjs --install-hook"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.4"
  }
