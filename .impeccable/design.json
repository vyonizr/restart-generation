  "narrative": {
    "northStar": "The Stage",
    "overview": "The game's own screen is the hero. The page is a dark stage that frames the engine's 240 × 320 output at the largest size that fits one viewport, and everything around it recedes: a slim header, one line of mono text, a key legend, and a footer strip. The palette is near-black blue ink, white text, and a single crimson used for fills and marks.\n\nThe system is dark only (`color-scheme: dark`). Depth comes from flat ink steps, not from layered cards. Type is loud only where it names things: Anton uppercase for the name, titles, and buttons. Raleway carries reading text, and Roboto Mono carries the quiet utility voice. Every corner is square.\n\nThe page draws no game art of its own. The only imagery is the engine's screen after the player's files load, plus a huge outlined ghost of the name behind it.",
    "keyCharacteristics": [
      "One centred game screen as the hero, sized by viewport height.",
      "Dark ink ground with one crimson accent.",
      "Anton uppercase display at line height `0.9`.",
      "Square corners everywhere.",
      "Buttons invert on hover over `0.2s`."
    ],
    "rules": [
      {
        "name": "The One Crimson Rule",
        "body": "Crimson is the only chromatic color. Use it for fills, the title bar, and selection, never for body text.",
        "section": "colors"
      },
      {
        "name": "The Ink Step Rule",
        "body": "Separate regions by stepping the ink ramp (`ink-1` ground, `ink-2` strips and dialogs), not by borders or tinted panels.",
        "section": "colors"
      },
      {
        "name": "The Display Is Uppercase Rule",
        "body": "Anton is always uppercase, weight 400, with line height `0.9` for headings and `1` for single-line labels. Headings use `text-wrap: balance`.",
        "section": "typography"
      },
      {
        "name": "The Mono Is An Aside Rule",
        "body": "Roboto Mono is limited to the header tag, the hero line, the footer, and key caps. Don't use it for headings, buttons, or form text.",
        "section": "typography"
      },
      {
        "name": "The Flat Frame Rule",
        "body": "Header, footer, legend, and buttons carry no shadow. Only the game screen and dialogs above it are lifted.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the game screen the largest object on the page and centred.",
      "**Do** set every display line in Anton 400 uppercase at line height `0.9`.",
      "**Do** mark titles with the crimson bar (`128px` by `4px`, `12px` below).",
      "**Do** keep every corner square (`0`).",
      "**Do** invert buttons on hover over `0.2s`: crimson to white for primary, muted outline to white outline for secondary.",
      "**Do** separate regions with ink steps (`ink-1`, `ink-2`)."
    ],
    "donts": [
      "**Don't** use crimson for body or running text.",
      "**Don't** introduce a second accent color or a light theme.",
      "**Don't** round corners.",
      "**Don't** use Roboto Mono beyond the header tag, hero line, footer, and key caps.",
      "**Don't** add shadows to anything except the game screen and dialogs over it.",
      "**Don't** add game art, screenshots, or RedLynx or Ubisoft logos to the page."
    ]
  }
}
